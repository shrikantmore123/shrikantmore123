<%- include('partials/header') %>

    <!-- Hero Section -->
    <section class="hero" id="home">
        <div class="hero-background"></div>
        <div class="container">
            <div class="hero-content">
                <div class="hero-text">
                    <h1 class="hero-title">
                        <span class="greeting">Hi, I'm</span>
                        <span class="name typing-animation"><%= typeof profile !== 'undefined' && profile.name ? profile.name : 'Your Name' %></span>
                    </h1>
                    <p class="hero-subtitle"><%= typeof profile !== 'undefined' && profile.title ? profile.title : 'Full Stack Developer' %></p>
                    <p class="hero-description"><%= typeof profile !== 'undefined' && profile.intro ? profile.intro : 'Creating amazing web experiences' %></p>
                    <div class="hero-buttons">
                        <a href="/projects" class="btn btn-primary">View Projects</a>
                        <a href="/contact" class="btn btn-secondary">Contact Me</a>
                    </div>
                </div>
                <div class="hero-image">
                    <div class="image-wrapper">
                        <div class="glow-effect"></div>
                        <img src="<%= typeof profile !== 'undefined' && profile.profileImage ? profile.profileImage : '/images/profile-placeholder.jpg' %>" alt="<%= typeof profile !== 'undefined' && profile.name ? profile.name : 'Profile' %>" class="profile-img">
                    </div>
                </div>
            </div>
        </div>
        <div class="scroll-indicator">
            <a href="#about" class="scroll-down">
                <span></span>
                <span></span>
                <span></span>
            </a>
        </div>
    </section>

    <!-- About Section -->
    <section class="about section" id="about">
        <div class="container">
            <h2 class="section-title">About Me</h2>
            <div class="about-content">
                <div class="about-image">
                    <div class="image-wrapper">
                        <img src="<%= typeof profile !== 'undefined' && profile.profileImage ? profile.profileImage : '/images/profile-placeholder.jpg' %>" alt="About">
                    </div>
                </div>
                <div class="about-text">
                    <p class="about-bio"><%= typeof profile !== 'undefined' && profile.bio ? profile.bio : 'Your bio here' %></p>
                    
                    <% if (typeof profile !== 'undefined' && profile.education && profile.education.length > 0) { %>
                    <div class="about-section">
                        <h3>Education</h3>
                        <% profile.education.forEach(function(edu) { %>
                        <div class="timeline-item">
                            <h4><%= edu.degree %></h4>
                            <p class="timeline-meta"><%= edu.school %> | <%= edu.year %></p>
                            <p><%= edu.description %></p>
                        </div>
                        <% }); %>
                    </div>
                    <% } %>

                    <% if (typeof profile !== 'undefined' && profile.experience && profile.experience.length > 0) { %>
                    <div class="about-section">
                        <h3>Experience</h3>
                        <% profile.experience.forEach(function(exp) { %>
                        <div class="timeline-item">
                            <h4><%= exp.position %></h4>
                            <p class="timeline-meta"><%= exp.company %> | <%= exp.period %></p>
                            <p><%= exp.description %></p>
                        </div>
                        <% }); %>
                    </div>
                    <% } %>
                </div>
            </div>
        </div>
    </section>

    <!-- Skills Section -->
    <section class="skills section" id="skills">
        <div class="container">
            <h2 class="section-title">Skills</h2>
            <% if (typeof profile !== 'undefined' && profile.skills) { %>
                <% if (profile.skills.frontend && profile.skills.frontend.length > 0) { %>
                <div class="skills-category">
                    <h3 class="category-title">Frontend</h3>
                    <div class="skills-grid">
                        <% profile.skills.frontend.forEach(function(skill) { %>
                        <div class="skill-card" data-aos="fade-up">
                            <div class="skill-header">
                                <span class="skill-name"><%= skill.name %></span>
                                <span class="skill-percentage"><%= skill.level %>%</span>
                            </div>
                            <div class="skill-bar">
                                <div class="skill-progress" style="width: <%= skill.level %>%"></div>
                            </div>
                        </div>
                        <% }); %>
                    </div>
                </div>
                <% } %>

                <% if (profile.skills.backend && profile.skills.backend.length > 0) { %>
                <div class="skills-category">
                    <h3 class="category-title">Backend</h3>
                    <div class="skills-grid">
                        <% profile.skills.backend.forEach(function(skill) { %>
                        <div class="skill-card" data-aos="fade-up">
                            <div class="skill-header">
                                <span class="skill-name"><%= skill.name %></span>
                                <span class="skill-percentage"><%= skill.level %>%</span>
                            </div>
                            <div class="skill-bar">
                                <div class="skill-progress" style="width: <%= skill.level %>%"></div>
                            </div>
                        </div>
                        <% }); %>
                    </div>
                </div>
                <% } %>

                <% if (profile.skills.tools && profile.skills.tools.length > 0) { %>
                <div class="skills-category">
                    <h3 class="category-title">Tools</h3>
                    <div class="skills-grid">
                        <% profile.skills.tools.forEach(function(skill) { %>
                        <div class="skill-card" data-aos="fade-up">
                            <div class="skill-header">
                                <span class="skill-name"><%= skill.name %></span>
                                <span class="skill-percentage"><%= skill.level %>%</span>
                            </div>
                            <div class="skill-bar">
                                <div class="skill-progress" style="width: <%= skill.level %>%"></div>
                            </div>
                        </div>
                        <% }); %>
                    </div>
                </div>
                <% } %>

                <% if (profile.skills.others && profile.skills.others.length > 0) { %>
                <div class="skills-category">
                    <h3 class="category-title">Others</h3>
                    <div class="skills-grid">
                        <% profile.skills.others.forEach(function(skill) { %>
                        <div class="skill-card" data-aos="fade-up">
                            <div class="skill-header">
                                <span class="skill-name"><%= skill.name %></span>
                                <span class="skill-percentage"><%= skill.level %>%</span>
                            </div>
                            <div class="skill-bar">
                                <div class="skill-progress" style="width: <%= skill.level %>%"></div>
                            </div>
                        </div>
                        <% }); %>
                    </div>
                </div>
                <% } %>
            <% } %>
        </div>
    </section>

<%- include('partials/footer') %>
